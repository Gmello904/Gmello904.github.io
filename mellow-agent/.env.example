GROQ_API_KEY=your-key-here
MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b
PORT=3000

# Free tries for visitors who are not logged in
GUEST_LIMIT=5

# Free minutes of use before the payment box appears
TRIAL_MINUTES=5

# test = no real money, plans activate instantly (for trying it out)
# payfast = real payments through PayFast
PAYMENTS_MODE=test

# Only needed when PAYMENTS_MODE=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# The public address of your app once it is online
APP_URL=http://localhost:3000

# ---- Google login ----
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# ---- Account activation by SMS ----
# test = the code is printed in the terminal (no real SMS); twilio = real SMS through Twilio Verify
SMS_MODE=test
REQUIRE_PHONE_VERIFY=true
DEFAULT_COUNTRY_CODE=27
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Your own login email: it unlocks the Admin page (users, revenue, give plans)
ADMIN_EMAIL=
